# وُصلة — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم

# === قاعدة البيانات ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# === تيليجرام — بوتات ===
# بوت العميل
TELEGRAM_RIDER_BOT_TOKEN=your-rider-bot-token
# بوت السائق
TELEGRAM_DRIVER_BOT_TOKEN=your-driver-bot-token
# بوت التاجر
TELEGRAM_MERCHANT_BOT_TOKEN=your-merchant-bot-token
# بوت المؤسسة
TELEGRAM_ENTERPRISE_BOT_TOKEN=your-enterprise-bot-token
# بوت الإدارة
TELEGRAM_ADMIN_BOT_TOKEN=your-admin-bot-token
# بوت الدعم
TELEGRAM_SUPPORT_BOT_TOKEN=your-support-bot-token

# === المجموعات ===
MANAGEMENT_GROUP_ID=-1001234567890
SUPPORT_GROUP_ID=-1001234567890

# === الخرائط ===
MAPBOX_ACCESS_TOKEN=your-mapbox-token
# أو
GOOGLE_MAPS_API_KEY=your-google-maps-key

# === الدفع ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STC_PAY_API_KEY=your-stcpay-key
SADAD_MERCHANT_ID=your-sadad-id

# === الأمان ===
HMAC_SECRET_KEY=your-hmac-secret-64-chars-min
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
ENCRYPTION_KEY=your-encryption-key-hex

# === الذكاء الاصطناعي ===
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.lovable.dev/v1

# === الإشعارات ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASS=your-password
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# === الإعدادات العامة ===
APP_NAME=وُصلة
APP_URL=https://waslah.app
DEFAULT_CITY=جدة
DEFAULT_LANG=ar
TIMEZONE=Asia/Riyadh

# === الإدارة ===
ADMIN_IDS=123456789,987654321

# === المراقبة ===
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info